# Copiar como .env y ajustar
DATABASE_URL=postgresql+psycopg2://alerta:alerta@localhost:5432/alertabarrio
AI_SERVICE_URL=http://localhost:8001
JWT_SECRET=cambiar-por-un-secreto-largo
TEAM_MEMBERS=Integrante 1,Integrante 2
CORS_ORIGINS=*
SEED_ON_STARTUP=true
TIMEZONE=America/Bogota
VERIFICATIONS_REQUIRED=2
# Ciudad que muestra la app
CITY=Pasto
# Clave de las cuentas de prueba del seed y de la cuenta del profesor
DEMO_PASSWORD=Alerta2026*
# PROFESOR_PASSWORD=
# Cuanto espera el chat a que despierte la IA (Render plan gratis)
AI_WAKE_SECONDS=45
