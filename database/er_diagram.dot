digraph ER {
  graph [rankdir=LR, splines=true, nodesep=0.5, ranksep=1.1, bgcolor="white", fontname="Helvetica", label="AlertaBarrio - Diagrama Entidad-Relacion", labelloc=t, fontsize=22];
  node [shape=plaintext, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#475569", arrowhead=crow, arrowtail=tee, dir=both];
  incident_types [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>incident_types</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">code</td><td align="left"><font color="#64748b">varchar(40) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">name</td><td align="left"><font color="#64748b">varchar(80) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">severity_level</td><td align="left"><font color="#64748b">smallint NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">color</td><td align="left"><font color="#64748b">varchar(7) NN</font></td></tr></table>>];
  neighborhoods [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>neighborhoods</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">name</td><td align="left"><font color="#64748b">varchar(100) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">city</td><td align="left"><font color="#64748b">varchar(100) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">latitude</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">longitude</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  roles [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>roles</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">name</td><td align="left"><font color="#64748b">varchar(30) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">description</td><td align="left"><font color="#64748b">varchar(200)</font></td></tr></table>>];
  daily_summaries [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>daily_summaries</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">neighborhood_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">summary_date</td><td align="left"><font color="#64748b">date NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">summary_text</td><td align="left"><font color="#64748b">text NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">reports_count</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">model_name</td><td align="left"><font color="#64748b">varchar(100) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  neighborhood_connections [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>neighborhood_connections</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">from_neighborhood_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">to_neighborhood_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">distance_meters</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">road_name</td><td align="left"><font color="#64748b">varchar(120)</font></td></tr></table>>];
  risk_hotspots [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>risk_hotspots</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">neighborhood_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">day_of_week</td><td align="left"><font color="#64748b">smallint NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">hour_block</td><td align="left"><font color="#64748b">smallint NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">risk_score</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">model_name</td><td align="left"><font color="#64748b">varchar(100) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">generated_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  users [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>users</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">full_name</td><td align="left"><font color="#64748b">varchar(120) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">email</td><td align="left"><font color="#64748b">varchar(150) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">password_hash</td><td align="left"><font color="#64748b">varchar(255) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">phone</td><td align="left"><font color="#64748b">varchar(30)</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">role_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">neighborhood_id</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">is_active</td><td align="left"><font color="#64748b">boolean NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  reports [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>reports</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">user_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">neighborhood_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">incident_type_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">title</td><td align="left"><font color="#64748b">varchar(150) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">description</td><td align="left"><font color="#64748b">text NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">latitude</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">longitude</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">occurred_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">status</td><td align="left"><font color="#64748b">varchar(20) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">priority_score</td><td align="left"><font color="#64748b">float NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">ai_suggested_type_id</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">ai_confidence</td><td align="left"><font color="#64748b">float</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">ai_zone_risk</td><td align="left"><font color="#64748b">float</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">updated_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  subscriptions [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>subscriptions</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">user_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">neighborhood_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  ai_analyses [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>ai_analyses</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">analysis_type</td><td align="left"><font color="#64748b">varchar(30) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">report_id</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">neighborhood_id</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">model_name</td><td align="left"><font color="#64748b">varchar(100) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">latency_ms</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">result</td><td align="left"><font color="#64748b">json</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  notifications [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>notifications</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">user_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">report_id</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">message</td><td align="left"><font color="#64748b">varchar(300) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">is_read</td><td align="left"><font color="#64748b">boolean NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  report_photos [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>report_photos</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">report_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">url</td><td align="left"><font color="#64748b">varchar(500) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  report_status_history [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>report_status_history</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">report_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">previous_status</td><td align="left"><font color="#64748b">varchar(20)</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">new_status</td><td align="left"><font color="#64748b">varchar(20) NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">changed_by</td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">note</td><td align="left"><font color="#64748b">varchar(255)</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">changed_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
  report_verifications [label=<<table border="0" cellborder="1" cellspacing="0" cellpadding="4"><tr><td colspan="3" bgcolor="#b91c1c"><font color="white"><b>report_verifications</b></font></td></tr><tr><td align="left" width="28"><font color="#b45309">PK</font></td><td align="left"><b>id</b></td><td align="left"><font color="#64748b">integer</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">report_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309">FK</font></td><td align="left">user_id</td><td align="left"><font color="#64748b">integer NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">is_confirmed</td><td align="left"><font color="#64748b">boolean NN</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">comment</td><td align="left"><font color="#64748b">varchar(255)</font></td></tr><tr><td align="left" width="28"><font color="#b45309"> </font></td><td align="left">created_at</td><td align="left"><font color="#64748b">datetime NN</font></td></tr></table>>];
